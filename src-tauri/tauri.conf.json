{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RCL",
  "version": "1.1.3",
  "identifier": "com.redstonest.redcraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RCL",
        "width": 1080,
        "height": 700,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#F4EFE6"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' rcicon: http://rcicon.localhost asset: http://asset.localhost https://asset.localhost data: https://cdn.modrinth.com https://*.modrinth.com https://media.forgecdn.net https://*.forgecdn.net https://textures.minecraft.net; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "Game",
    "shortDescription": "Minecraft Java 版启动器",
    "longDescription": "RCL（Red Craft Launcher）是一个轻量、快速的 Minecraft Java 版启动器。",
    "copyright": "© 2026 RVlion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "5127FA2E-7CA7-563D-B15F-DDEC263B090F"
      }
    }
  }
}
