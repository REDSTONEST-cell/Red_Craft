{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Red Craft",
  "version": "0.1.0",
  "identifier": "com.redstonest.redcraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Red Craft",
        "width": 1080,
        "height": 700,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#F4EFE6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cdn.modrinth.com https://*.modrinth.com https://crafatar.com https://mc-heads.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg", "app"],
    "category": "Game",
    "shortDescription": "Minecraft Java 版启动器",
    "longDescription": "Red Craft 是一个轻量、快速的 Minecraft Java 版启动器。",
    "copyright": "© 2026 RVlion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
